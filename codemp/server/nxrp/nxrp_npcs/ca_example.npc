// ca_example.npc
// Minimal example NPC for the nxrp_npcs folder.
// Copy/modify this file to create new NPCs for the NXRP namespace.

npc "nx_example" {
	displayName "NX Example NPC"
	model "models/characters/example.md3"    // replace with an existing model
	spawnflags 0
	health 100
	team 0
	behavior "neutral"

	// spawn positioning: if your NPC system supports explicit origin/angles
	// you can add: origin "0 0 0" angles "0 0 0"

	script {
		on_spawn {
			// simple greeting when the NPC spawns
			say "Hello, I am an example NPC."
		}

		on_interact {
			// what happens when a player interacts with this NPC
			say "You interacted with the example NPC."
		}
	}
}
